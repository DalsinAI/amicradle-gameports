+static void openup_apply_profile(void)
+{
+    const char *profile;
+
+    if (openup_profile_applied)
+        return;
+    openup_profile_applied = 1;
+
+    profile = SDL_getenv("NEVERBALL_PROFILE");
+    if (profile && strcmp(profile, "68040") == 0)
+    {
+        config_set_d(CONFIG_WIDTH,       640);
+        config_set_d(CONFIG_HEIGHT,      480);
+        config_set_d(CONFIG_REFLECTION,    0);
+        config_set_d(CONFIG_SHADOW,        0);
+        config_set_d(CONFIG_MULTISAMPLE,   0);
+        config_set_d(CONFIG_MIPMAP,        0);
+        config_set_d(CONFIG_ANISO,         0);
+        config_set_d(CONFIG_VSYNC,         0);
+        config_set_d(CONFIG_HIGHDPI,       0);
+        log_printf("Performance profile: 68040 fallback (640x480, reduced effects)\n");
+    }
+    else
+        log_printf("Performance profile: automatic OpenGPU/softpipe selection\n");
+
+    log_printf("Video backend: %s\n",
+               SDL_GetCurrentVideoDriver() ? SDL_GetCurrentVideoDriver() : "unknown");
+}
